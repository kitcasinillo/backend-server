# Server Configuration
NODE_ENV=development
PORT=5001

# Firebase Admin (Backend)
# Option A: explicit env vars (recommended for Koyeb)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Optional alternative: base64-encoded private key instead of FIREBASE_PRIVATE_KEY
# FIREBASE_PRIVATE_KEY_BASE64=
# Optional alternative: Application Default Credentials file path
# GOOGLE_APPLICATION_CREDENTIALS=/workspace/serviceAccountKey.json

# Stripe (Backend)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Ultra Healers" <your-email@gmail.com>

# Admin Notification Configuration (Recipient for owner/admin signup alerts & system notifications)
ADMIN_NOTIFICATION_EMAIL=admin@ultrahealers.com
# Alternative fallbacks: ADMIN_EMAIL, OWNER_EMAIL, NOTIFICATION_EMAIL

# Frontend Application URLs (Used in Email Templates & Dashboard Redirect Links)
SEEKER_APP_URL=http://localhost:5173
HEALER_APP_URL=http://localhost:5174

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Session Configuration
SESSION_SECRET=your-super-secret-session-key
JWT_SECRET=your-jwt-secret-key
