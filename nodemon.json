{
  "watch": ["server.js", "routes", "controllers", "config", "utils", "models"],
  "ext": "js,json",
  "ignore": ["node_modules/", "*.test.js", "*.spec.js"],
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "1000",
  "legacyWatch": true,
  "exitcrash": true,
  "restartable": "rs",
  "verbose": false,
  "colours": false
}
